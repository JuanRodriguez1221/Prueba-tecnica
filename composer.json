{
  "name": "technical-test/voting-system-api",
  "description": "RESTful API in PHP for managing voters, candidates and votes.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "VotingSystem\\": "src/"
    }
  },
  "scripts": {
